{
  "name": "calvyntwh-minimax",
  "displayName": "MiniMax Token Plan (BYOK)",
  "description": "BYOK language model provider for GitHub Copilot in VS Code using MiniMax Token Plan models. Native fetch, zero runtime dependencies, all 8 Token Plan models (M3 + M2.x family).",
  "version": "1.3.0",
  "publisher": "calvyntwh",
  "license": "MIT",
  "keywords": ["minimax", "copilot", "byok", "language-model", "ai", "chat"],
  "icon": "icon/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/calvyntwh/minimax-vscode"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:calvyntwh.minimax"
  ],
  "contributes": {
    "commands": [
      { "command": "minimax.setApiKey", "title": "MiniMax: Set API Key" },
      { "command": "minimax.clearApiKey", "title": "MiniMax: Clear API Key" },
      { "command": "minimax.setThinkingMode", "title": "MiniMax: Set Thinking Mode" }
    ],
    "configuration": {
      "title": "MiniMax",
      "properties": {
        "minimax.apiBaseUrl": {
          "type": "string",
          "default": "https://api.minimax.io/v1",
          "markdownDescription": "API base URL. Must end with `/v1`.",
          "scope": "application"
        },
        "minimax.thinking": {
          "type": "string",
          "enum": ["adaptive", "enabled", "disabled"],
          "default": "adaptive",
          "markdownDescription": "Thinking behavior. `adaptive` lets the model decide per call.",
          "scope": "application"
        },
        "minimax.reasoningSplit": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Always true. Switches thinking into a dedicated stream field.",
          "scope": "application"
        },
        "minimax.showThinking": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When true, the model's chain-of-thought is rendered as `<think>...</think>` markers in the chat UI. On VS Code Insiders with the proposed `languageModelThinkingPart` API enabled, renders as a collapsible block instead. Set false to hide thinking entirely.",
          "scope": "application"
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "calvyntwh.minimax",
        "displayName": "MiniMax"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ -w"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.3.0"
  }
}
